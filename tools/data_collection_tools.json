{
  "toolset": "data_collection_search",
  "description": "数据收集项目检索相关能力，支持搜索、筛选和统计。",
  "execution": {
    "mode": "http",
    "client": ["curl", "python-requests"],
    "not_via": "mcp",
    "config_file": "api-config.json",
    "default_base_url": "https://jujidata.com",
    "auth_header": "Authorization: Bearer <api_key>"
  },
  "tools": [
    {
      "name": "search_collected_records",
      "description": "按条件搜索已收集的数据记录。",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string", "description": "数据项目编号" },
          "filters": { "type": "object", "description": "查询参数，例如 region, status, tags" },
          "limit": { "type": "integer", "default": 50 }
        },
        "required": ["project_id"]
      },
      "api": {
        "method": "POST",
        "url": "/api/projects/{project_id}/search"
      },
      "examples": {
        "curl": "curl -sS -X POST \"${BASE_URL}/api/projects/${PROJECT_ID}/search\" -H \"Authorization: Bearer ${API_KEY}\" -H \"Content-Type: application/json\" -d '{\"filters\": {\"region\": \"东区\"}, \"limit\": 50}'",
        "python_requests": "requests.post(f\"{base_url}/api/projects/{project_id}/search\", json={\"filters\": filters, \"limit\": limit}, headers={\"Authorization\": f\"Bearer {api_key}\", \"Content-Type\": \"application/json\"}, timeout=30)"
      }
    },
    {
      "name": "summarize_records",
      "description": "按字段汇总数据，输出数量和占比。",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string", "description": "数据项目编号" },
          "group_by": { "type": "array", "items": { "type": "string" }, "description": "按字段分组" }
        },
        "required": ["project_id", "group_by"]
      },
      "api": {
        "method": "POST",
        "url": "/api/projects/{project_id}/summary"
      },
      "examples": {
        "curl": "curl -sS -X POST \"${BASE_URL}/api/projects/${PROJECT_ID}/summary\" -H \"Authorization: Bearer ${API_KEY}\" -H \"Content-Type: application/json\" -d '{\"group_by\": [\"status\", \"region\"]}'",
        "python_requests": "requests.post(f\"{base_url}/api/projects/{project_id}/summary\", json={\"group_by\": group_by}, headers={\"Authorization\": f\"Bearer {api_key}\", \"Content-Type\": \"application/json\"}, timeout=30)"
      }
    }
  ]
}
