{
  "toolset": "open_api_identity",
  "description": "验证据吉 API Key，并读取服务端从 Key 恢复出的可信身份。当前不提供采集记录搜索能力。",
  "execution": {
    "mode": "http",
    "client": ["curl", "python-requests"],
    "not_via": "mcp",
    "config_file": "api-config.json",
    "default_base_url": "https://jujidata.com",
    "auth_header": "X-API-Key: <api_key>"
  },
  "tools": [
    {
      "name": "verify_api_key",
      "description": "验证 API Key，并返回其绑定的用户、Membership、企业、Scope 和过期时间。",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "url": "/api/open-api/v1/me"
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "auth_type": { "type": "string", "const": "api_key" },
          "credential_id": { "type": "string" },
          "user_id": { "type": "integer" },
          "membership_id": { "type": "integer" },
          "enterprise_id": { "type": "integer" },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "expires_at": { "type": "string", "format": "date-time" }
        },
        "required": ["auth_type", "credential_id", "user_id", "membership_id", "enterprise_id", "scopes", "expires_at"]
      },
      "examples": {
        "curl": "curl --fail-with-body -sS \"${BASE_URL}/api/open-api/v1/me\" -H \"X-API-Key: ${API_KEY}\" -H \"Accept: application/json\"",
        "python_requests": "requests.get(f\"{base_url}/api/open-api/v1/me\", headers={\"X-API-Key\": api_key, \"Accept\": \"application/json\"}, timeout=30)"
      }
    }
  ]
}
