{
  "toolset": "project_progress_management",
  "description": "分页查询当前身份可见项目，并读取项目安全详情和聚合进度统计。",
  "execution": {
    "mode": "http",
    "client": ["curl", "python-requests"],
    "not_via": "mcp",
    "config_file": "api-config.json",
    "default_base_url": "https://jujidata.com",
    "auth_header": "X-API-Key: <api_key>"
  },
  "tools": [
    {
      "name": "list_projects",
      "description": "按必填的项目类型分页查询 API Key 身份有权查看的项目。",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_type": { "type": "string", "enum": ["annotation", "collection"], "description": "必填，annotation 为标注项目，collection 为采集项目" },
          "page": { "type": "integer", "minimum": 1, "default": 1 },
          "page_size": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
        },
        "required": ["project_type"],
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "url": "/api/open-api/v1/projects"
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/definitions/project" } },
          "page": { "type": "integer" },
          "page_size": { "type": "integer" },
          "has_more": { "type": "boolean" }
        },
        "required": ["items", "page", "page_size", "has_more"]
      },
      "examples": {
        "curl": "curl --fail-with-body -sS \"${BASE_URL}/api/open-api/v1/projects?project_type=${PROJECT_TYPE}&page=${PAGE}&page_size=${PAGE_SIZE}\" -H \"X-API-Key: ${API_KEY}\" -H \"Accept: application/json\"",
        "python_requests": "requests.get(f\"{base_url}/api/open-api/v1/projects\", params={\"project_type\": project_type, \"page\": page, \"page_size\": page_size}, headers={\"X-API-Key\": api_key, \"Accept\": \"application/json\"}, timeout=30)"
      }
    },
    {
      "name": "get_project",
      "description": "查询单个可见项目的最小安全详情；不存在或无权限均返回 404。",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "integer", "minimum": 1, "description": "项目 ID" }
        },
        "required": ["project_id"],
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "url": "/api/open-api/v1/projects/{project_id}"
      },
      "response_schema": { "$ref": "#/definitions/project" },
      "examples": {
        "curl": "curl --fail-with-body -sS \"${BASE_URL}/api/open-api/v1/projects/${PROJECT_ID}\" -H \"X-API-Key: ${API_KEY}\" -H \"Accept: application/json\"",
        "python_requests": "requests.get(f\"{base_url}/api/open-api/v1/projects/{project_id}\", headers={\"X-API-Key\": api_key, \"Accept\": \"application/json\"}, timeout=30)"
      }
    },
    {
      "name": "get_project_statistics",
      "description": "查询单个可见项目的任务聚合统计和完成率。采集项目还可返回人脸去重累计扣费次数。",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "integer", "minimum": 1, "description": "项目 ID" }
        },
        "required": ["project_id"],
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "url": "/api/open-api/v1/projects/{project_id}/statistics"
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "integer" },
          "total_tasks": { "type": "integer", "minimum": 0 },
          "completed_tasks": { "type": "integer", "minimum": 0 },
          "pending_review_tasks": { "type": "integer", "minimum": 0 },
          "tasks_with_annotations": { "type": "integer", "minimum": 0 },
          "skipped_annotations": { "type": "integer", "minimum": 0 },
          "used_dedup_face_quota": { "type": ["integer", "null"], "minimum": 0, "description": "采集项目中可追溯的累计人脸去重扣费次数。非采集项目返回 null，旧版服务可能不返回此字段。" },
          "completion_rate": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["project_id", "total_tasks", "completed_tasks", "pending_review_tasks", "tasks_with_annotations", "skipped_annotations", "completion_rate"]
      },
      "examples": {
        "curl": "curl --fail-with-body -sS \"${BASE_URL}/api/open-api/v1/projects/${PROJECT_ID}/statistics\" -H \"X-API-Key: ${API_KEY}\" -H \"Accept: application/json\"",
        "python_requests": "requests.get(f\"{base_url}/api/open-api/v1/projects/{project_id}/statistics\", headers={\"X-API-Key\": api_key, \"Accept\": \"application/json\"}, timeout=30)"
      }
    }
  ],
  "definitions": {
    "project": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "title": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "project_type": { "type": "string", "enum": ["annotation", "collection"], "description": "annotation 为标注项目，collection 为采集项目" },
        "job_type": { "type": ["string", "null"], "enum": ["SELF_ANNOTATION", "OUTSOURCE", null], "description": "标注项目模式：SELF_ANNOTATION 为自标，OUTSOURCE 为外包；采集项目或未关联作业时为 null" },
        "job_status": { "type": ["string", "null"], "description": "作业状态原始值；in-process 表示进行中，aborted 表示已中止，null 表示未提供状态；其他值保留原值，不猜测翻译" },
        "created_at": { "type": ["string", "null"], "format": "date-time" },
        "updated_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "required": ["id", "title", "description", "project_type", "job_type", "job_status", "created_at", "updated_at"]
    }
  }
}
