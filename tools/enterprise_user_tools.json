{
  "toolset": "enterprise_summary",
  "description": "查询 API Key 绑定企业的最小信息和成员角色聚合。",
  "execution": {
    "mode": "http",
    "client": ["curl", "python-requests"],
    "not_via": "mcp",
    "config_file": "api-config.json",
    "default_base_url": "https://jujidata.com",
    "auth_header": "X-API-Key: <api_key>"
  },
  "tools": [
    {
      "name": "get_current_enterprise",
      "description": "查询 API Key 绑定企业的 ID 和名称。企业范围由服务端身份决定，不接收 enterprise_id。",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "url": "/api/open-api/v1/enterprise"
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        },
        "required": ["id", "name"]
      },
      "examples": {
        "curl": "curl --fail-with-body -sS \"${BASE_URL}/api/open-api/v1/enterprise\" -H \"X-API-Key: ${API_KEY}\" -H \"Accept: application/json\"",
        "python_requests": "requests.get(f\"{base_url}/api/open-api/v1/enterprise\", headers={\"X-API-Key\": api_key, \"Accept\": \"application/json\"}, timeout=30)"
      }
    },
    {
      "name": "get_enterprise_user_summary",
      "description": "查询当前企业成员总数及按角色聚合的数量；不返回成员明细。",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "url": "/api/open-api/v1/enterprise/users/summary"
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "total_count": { "type": "integer", "minimum": 0 },
          "by_role": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        },
        "required": ["total_count", "by_role"]
      },
      "examples": {
        "curl": "curl --fail-with-body -sS \"${BASE_URL}/api/open-api/v1/enterprise/users/summary\" -H \"X-API-Key: ${API_KEY}\" -H \"Accept: application/json\"",
        "python_requests": "requests.get(f\"{base_url}/api/open-api/v1/enterprise/users/summary\", headers={\"X-API-Key\": api_key, \"Accept\": \"application/json\"}, timeout=30)"
      }
    }
  ]
}
