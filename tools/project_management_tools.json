{
  "toolset": "project_progress_management",
  "description": "项目进度管理相关能力，用于读取进度和总结事项。",
  "execution": {
    "mode": "http",
    "client": ["curl", "python-requests"],
    "not_via": "mcp",
    "config_file": "api-config.json",
    "default_base_url": "https://jujidata.com",
    "auth_header": "Authorization: Bearer <api_key>"
  },
  "tools": [
    {
      "name": "get_project_summary",
      "description": "获取项目整体状态和完成进度。",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string", "description": "项目编号" },
          "include_risk": { "type": "boolean", "default": true }
        },
        "required": ["project_id"]
      },
      "api": {
        "method": "GET",
        "url": "/api/projects/{project_id}/summary"
      },
      "examples": {
        "curl": "curl -sS -X GET \"${BASE_URL}/api/projects/${PROJECT_ID}/summary?include_risk=${INCLUDE_RISK}\" -H \"Authorization: Bearer ${API_KEY}\" -H \"Content-Type: application/json\"",
        "python_requests": "requests.get(f\"{base_url}/api/projects/{project_id}/summary\", params={\"include_risk\": include_risk}, headers={\"Authorization\": f\"Bearer {api_key}\", \"Content-Type\": \"application/json\"}, timeout=30)"
      }
    },
    {
      "name": "list_task_status",
      "description": "列出项目各任务的状态和负责人。",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string", "description": "项目编号" },
          "status": { "type": "string", "description": "筛选状态，例如 done, in_progress, blocked" }
        },
        "required": ["project_id"]
      },
      "api": {
        "method": "GET",
        "url": "/api/projects/{project_id}/tasks"
      },
      "examples": {
        "curl": "curl -sS -X GET \"${BASE_URL}/api/projects/${PROJECT_ID}/tasks?status=${STATUS}\" -H \"Authorization: Bearer ${API_KEY}\" -H \"Content-Type: application/json\"",
        "python_requests": "requests.get(f\"{base_url}/api/projects/{project_id}/tasks\", params={\"status\": status}, headers={\"Authorization\": f\"Bearer {api_key}\", \"Content-Type\": \"application/json\"}, timeout=30)"
      }
    }
  ]
}
